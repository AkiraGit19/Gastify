DATABASE_URL=postgresql://akirasanchez@localhost:5432/gastify_dev
JWT_SECRET=dev-secret-change-in-production
PORT=4000
FRONTEND_URL=http://localhost:5173

# WhatsApp Business (Meta Cloud API) - leave empty to run webhook in log-only mode
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# App secret from Meta app settings - verifies incoming webhook requests are really from Meta.
# Required before going live; without it the webhook accepts unsigned requests (dev-only).
WHATSAPP_APP_SECRET=

# OCR - leave empty to always fall back to manual entry flow
GOOGLE_VISION_API_KEY=

# SUNAT validation - leave empty to mark expenses as pendiente_validacion
SUNAT_VALIDATION_API_KEY=

# Image storage (Supabase Storage) - leave empty to store images locally in dev
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
