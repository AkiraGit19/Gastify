generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  super_admin
  admin
  aprobador
  empleado
}

enum EstadoGasto {
  pendiente
  aprobado
  rechazado
  pendiente_validacion
  // El ciclo no termina en "aprobado": la empresa todavía le debe la plata al empleado.
  pagado
  // Los registros financieros no se borran. Un gasto mal cargado se anula con motivo y
  // queda a la vista en la auditoría, que es lo que un contador espera poder revisar.
  anulado
}

// En Perú solo las FACTURAS dan derecho a crédito fiscal; las boletas de venta no. Un export
// que no distingue las dos cosas no le sirve al contador, así que el tipo es parte del gasto.
// Se infiere de la serie (F001 = factura, B001 = boleta) y se puede corregir a mano.
enum TipoComprobante {
  factura
  boleta
  recibo_honorarios
  otro
}

enum Categoria {
  movilidad
  alimentacion
  hospedaje
  otros
}

model Empresa {
  id          String   @id @default(cuid())
  razonSocial String
  ruc         String   @unique
  fechaAlta   DateTime @default(now())

  usuarios Usuario[]
  gastos   Gasto[]
}

model Usuario {
  id               String    @id @default(cuid())
  empresaId        String?
  empresa          Empresa?  @relation(fields: [empresaId], references: [id])
  nombre           String
  telefonoWhatsapp String?   @unique
  email            String    @unique
  passwordHash     String
  rol              Rol
  activo           Boolean   @default(true)
  aprobadorId      String?
  aprobador        Usuario?  @relation("ReportaA", fields: [aprobadorId], references: [id])
  reportes         Usuario[] @relation("ReportaA")

  gastos       Gasto[]
  aprobaciones Aprobacion[]
  ediciones    EdicionGasto[] @relation("EdicionesHechas")

  // Bloqueo temporal tras varios intentos fallidos. Temporal y no permanente a propósito:
  // un bloqueo definitivo convierte el login en una forma de dejar fuera a un compañero.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  @@index([empresaId])
}

model Gasto {
  id                String          @id @default(cuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  usuarioId         String
  usuario           Usuario         @relation(fields: [usuarioId], references: [id])
  monto             Decimal         @db.Decimal(10, 2)
  fechaGasto        DateTime
  categoria         Categoria
  rucEmisor         String?
  razonSocialEmisor String?
  numeroComprobante String?
  tipoComprobante   TipoComprobante @default(otro)
  // IGV que el contador puede reclamar. Nullable a propósito: no leerlo es distinto de que
  // sea cero (una boleta sin IGV desglosado vs. un servicio inafecto).
  igv               Decimal?        @db.Decimal(10, 2)
  imagenUrl         String
  // SHA-256 de los bytes de la imagen. Es la única defensa contra subir dos veces la misma
  // boleta cuando el OCR no pudo leer ni el RUC ni el número de comprobante.
  imagenHash        String?
  estado            EstadoGasto     @default(pendiente)
  validadoSunat     Boolean         @default(false)
  // Qué dijo SUNAT del comprobante: null si todo bien o si no se pudo consultar, y un texto
  // corto cuando hay algo que quien aprueba tiene que ver ("SUNAT reporta el comprobante como
  // ANULADO"). Es la diferencia entre leer una foto y verificar un gasto.
  observacionSunat  String?
  fechaCreacion     DateTime        @default(now())
  fechaPago         DateTime?
  motivoAnulacion   String?

  aprobaciones Aprobacion[]
  ediciones    EdicionGasto[]

  @@unique([empresaId, rucEmisor, numeroComprobante])
  @@index([empresaId])
  @@index([usuarioId])
  @@index([empresaId, imagenHash])
}

// Quién cambió qué y cuándo. En un sistema donde alguien puede editar el monto de un gasto ya
// registrado, sin este rastro no hay forma de auditar una rendición — y es lo primero que
// pregunta un contador cuando una cifra no le cuadra.
model EdicionGasto {
  id            String   @id @default(cuid())
  gastoId       String
  gasto         Gasto    @relation(fields: [gastoId], references: [id])
  usuarioId     String
  usuario       Usuario  @relation("EdicionesHechas", fields: [usuarioId], references: [id])
  campo         String
  valorAnterior String?
  valorNuevo    String?
  fecha         DateTime @default(now())

  @@index([gastoId])
}

model Aprobacion {
  id            String   @id @default(cuid())
  gastoId       String
  gasto         Gasto    @relation(fields: [gastoId], references: [id])
  aprobadorId   String
  aprobador     Usuario  @relation(fields: [aprobadorId], references: [id])
  decision      Boolean
  fechaDecision DateTime @default(now())
  comentario    String?
}

// Short-lived scratch space for the WhatsApp conversation state machine —
// what the bot is waiting for next from this phone number (confirm / correct a field / pick category).
model ConversacionWA {
  id            String   @id @default(cuid())
  usuarioId     String   @unique
  paso          String
  datos         Json
  actualizadoEn DateTime @updatedAt
}

// Registro de errores del backend.
//
// Se guarda en la propia base y no en un servicio externo a propósito: así el monitoreo funciona
// desde el primer despliegue, sin cuentas que crear ni claves que configurar. Un panel que exige
// setup es un panel que nadie enciende, y entonces uno se entera de las caídas porque llama un
// cliente.
//
// ponytail: sirve para uno o tres clientes. Cuando haga falta alertar por correo en vez de
// mirar una pantalla, el reemplazo natural es Sentry — el punto de captura ya está centralizado
// en el middleware de errores de index.ts.
model ErrorRegistrado {
  id      String  @id @default(cuid())
  // SHA-256 de mensaje+ruta+método: agrupa el mismo fallo repetido en una fila con un contador,
  // en vez de llenar la tabla con diez mil copias durante una caída.
  huella  String  @unique
  mensaje String
  ruta    String
  metodo  String
  stack   String?
  conteo  Int     @default(1)

  primeraVez DateTime @default(now())
  ultimaVez  DateTime @default(now())

  @@index([ultimaVez])
}
